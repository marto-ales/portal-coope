{# templates/receipt/index.html.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ portal.description }}">
    <link rel="icon" type="image/jpeg" href="{{ asset(portal.logo) }}">
    <link rel="apple-touch-icon" href="{{ asset(portal.logo) }}">
    <title>{{ portal.title }} · Consulta de recibos</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {# Altcha – CAPTCHA self-hosted (desafío generado por /captcha/challenge) #}
    <script async defer src="https://cdn.jsdelivr.net/npm/altcha@3.6.0/dist/main/altcha.min.js" type="module"></script>
</head>

<body>
<div class="page">
    <span class="blob blob-1" aria-hidden="true"></span>
    <span class="blob blob-2" aria-hidden="true"></span>
    <span class="blob blob-3" aria-hidden="true"></span>

    <main class="wrap">
        <header class="hero">
            <div class="logo-card">
                <img src="{{ asset(portal.logo) }}" alt="{{ portal.title }}">
            </div>
            <span class="eyebrow">Portal de la cooperadora</span>
            <h1>{{ portal.title }}</h1>
            <p class="lead">{{ portal.subtitle }}</p>
            <p class="desc">{{ portal.description }}</p>
        </header>

        {# Información de contacto #}
        <section class="info-grid">
            <article class="info-card">
                <h3>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <path d="M14 2v6h6"></path>
                        <path d="M8 13h8M8 17h8"></path>
                    </svg>
                    Informaste un pago
                </h3>
                <p>Si pagaste por transferencia, recordá informar el pago completando el formulario.</p>
                <a class="contact-link" href="{{ portal.form_link }}" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 3h7v7"></path>
                        <path d="M21 3 10 14"></path>
                        <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"></path>
                    </svg>
                    Completar formulario de pago
                </a>
            </article>

            <article class="info-card info-card--grape">
                <h3>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 10h18M3 10 5 5h14l2 5M3 10v9h18v-9"></path>
                        <path d="M7 19v-5h10v5"></path>
                    </svg>
                    Datos para transferir
                </h3>
                <div class="bank-box">{{ portal.datos_banco }}</div>
                <a class="contact-link" href="mailto:{{ portal.email }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
                        <path d="m3 6 9 6 9-6"></path>
                    </svg>
                    {{ portal.email }}
                </a>
            </article>
        </section>

        <section class="search-card">
            <div class="search-head">
                <h2>Consultá tus recibos</h2>
                <p>Ingresá el documento y el correo con los que hiciste el pago.</p>
            </div>

            <form id="consultaForm" method="post" class="search-form">
                <div class="field">
                    <label for="id_number">Documento</label>
                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                            <circle cx="9" cy="10" r="2"></circle>
                            <path d="M15 8h3M15 12h3M7 16h10"></path>
                        </svg>
                        <input type="text" placeholder="De la persona que realizó el pago" id="id_number" name="id_number" autocomplete="off" required>
                    </div>
                </div>

                <div class="field">
                    <label for="email">Correo electrónico</label>
                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
                            <path d="m3 6 9 6 9-6"></path>
                        </svg>
                        <input type="email" placeholder="De la persona que realizó el pago" id="email" name="email" autocomplete="email" required>
                    </div>
                </div>

                <div class="submit-row">
                    {% if captcha_error %}
                        <div class="alert-error" role="alert">{{ captcha_error }}</div>
                    {% endif %}

                    <altcha-widget
                        challenge="{{ path('altcha_challenge') }}"
                        strings='{{ altcha.strings | json_encode }}'>
                    </altcha-widget>

                    <button type="submit" id="consultarBtn" class="btn-primary">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m20 20-3.2-3.2"></path>
                        </svg>
                        <span class="btn-label">Consultar recibos</span>
                        <span class="spinner" aria-hidden="true"></span>
                    </button>
                    <p class="hint">Usá los mismos datos que registraste en el formulario de pago.</p>
                </div>
            </form>
        </section>

        {# Resultados (solo después de POST) #}
        {% if app.request.method == "POST" %}
            <section class="results">
                {% if transfer or box %}
                    {% if transfer %}
                        <article class="result-card result-card--transfer">
                            <div class="result-head">
                                <div>
                                    <span class="pill">Transferencias</span>
                                    <h3>{{ transfer[0].name ?: 'Recibos por transferencia' }}</h3>
                                </div>
                                <span class="count">{{ transfer|length }}</span>
                            </div>
                            <ul class="receipt-list">
                                {% for item in transfer %}
                                    <li class="receipt-row">
                                        <div class="receipt-main">
                                            <div class="receipt-title">{{ item.student }}</div>
                                            <div class="receipt-meta">
                                                {{ item.item }}{% if item.desc %} · {{ item.desc }}{% endif %}
                                            </div>
                                        </div>
                                        <a class="download-btn" href="/drive/file/{{ item.receiptFile }}">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M12 3v12"></path>
                                                <path d="m7 10 5 5 5-5"></path>
                                                <path d="M5 21h14"></path>
                                            </svg>
                                            Descargar PDF
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </article>
                    {% endif %}

                    {% if box %}
                        <article class="result-card result-card--box">
                            <div class="result-head">
                                <div>
                                    <span class="pill">Sobres</span>
                                    <h3>{{ box[0].name ?: 'Recibos por sobre' }}</h3>
                                </div>
                                <span class="count">{{ box|length }}</span>
                            </div>
                            <ul class="receipt-list">
                                {% for item in box %}
                                    <li class="receipt-row">
                                        <div class="receipt-main">
                                            <div class="receipt-title">{{ item.student }}</div>
                                            <div class="receipt-meta">{{ item.month }}</div>
                                        </div>
                                        <a class="download-btn" href="/drive/file/{{ item.receiptFile }}">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M12 3v12"></path>
                                                <path d="m7 10 5 5 5-5"></path>
                                                <path d="M5 21h14"></path>
                                            </svg>
                                            Descargar PDF
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </article>
                    {% endif %}
                {% else %}
                    <div class="empty-state">
                        <span class="emoji" aria-hidden="true">🔎</span>
                        <h3>No encontramos recibos</h3>
                        <p>Revisá que el documento y el correo coincidan con los datos del pago.</p>
                    </div>
                {% endif %}
            </section>
        {% endif %}

    </main>

    <footer class="footer">
        Hecho con <span class="heart">♥</span> por la <strong>{{ portal.title }}</strong>
    </footer>
</div>

{# Overlay de carga #}
<div id="loadingOverlay" class="loading-overlay" aria-hidden="true">
    <span class="spinner-lg"></span>
</div>

<script>
    // --------- Indicador de carga ----------
    const form = document.getElementById('consultaForm');
    const btn = document.getElementById('consultarBtn');
    const overlay = document.getElementById('loadingOverlay');

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        btn.disabled = true;
        btn.classList.add('is-loading');
        overlay.classList.add('show');
        overlay.setAttribute('aria-hidden', 'false');

        // Pequeña espera para que el usuario vea el feedback y luego enviamos.
        setTimeout(() => form.submit(), 450);
    });
</script>
</body>
</html>
